{
  "name": "hardware-asset-management",
  "version": "1.0.0",
  "description": "Beginner-friendly full-stack Hardware Asset Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit"
